близости есть аптека?","附近有药店吗？"]]],[33,11,"урок","Больше всего люблю китайскую кухню · часть 3","","",[["今天下雨了。","jīntiān xià yǔ le.","Сегодня пошёл дождь."],["这里有好多人。","zhèlǐ yǒu hǎoduō rén.","Здесь очень много людей."],["你最好早点儿去。","nǐ zuìhǎo zǎo diǎnr qù.","Тебе лучше пойти пораньше."],["你最近忙吗？","nǐ zuìjìn máng ma?","Ты в последнее время занят?"]],[["今天＿＿了。",["最好","最近","下雨"],2,"今天下雨了。\nСегодня пошёл дождь."],["这里有＿＿人。",["最近","好多","最好"],1,"这里有好多人。\nЗдесь очень много людей."],["你＿＿早点儿去。",["好多","最近","最好"],2,"你最好早点儿去。\nТебе лучше пойти пораньше."],["你＿＿忙吗？",["最近","下雨","最好"],0,"你最近忙吗？\nТы в последнее время занят?"]],[[["今天","下雨","了","。"],"Сегодня пошёл дождь.","今天下雨了。"],[["这里","有","好多","人","。"],"Здесь очень много людей.","这里有好多人。"],[["你","最好","早","点儿","去","。"],"Тебе лучше пойти пораньше.","你最好早点儿去。"]]],[34,12,"урок","Здесь куда холоднее, чем в Пекине · часть 1","","Сравнительное предложение с 比. Формула: A + 比 + B + признак (+ 多了/一点儿). Показывает разницу: 这里比北京冷多了 — «здесь намного холоднее, чем в Пекине».",[["我比他高。","wǒ bǐ tā gāo.","Я выше его."],["他很高。","tā hěn gāo.","Он очень высокий."],["她的头发很长。","tā de tóufa hěn cháng.","У неё очень длинные волосы."],["雨停了，天晴了。","yǔ tíng le, tiān qíng le.","Дождь кончился, прояснилось."]],[["我＿＿他高。",["高","阴","比"],2,"我比他高。\nЯ выше его."],["他很＿＿。",["比","高","晴"],1,"他很高。\nОн очень высокий."],["她的头发很＿＿。",["比","高","长"],2,"她的头发很长。\nУ неё очень длинные волосы."],["雨停了，天＿＿了。",["晴","比","阴"],0,"雨停了，天晴了。\nДождь кончился, прояснилось."]],[[["我","比","他","高","。"],"Я выше его.","我比他高。"],[["他","很","高","。"],"Он очень высокий.","他很高。"],[["她","的","头发","很","长","。"],"У неё очень длинные волосы.","她的头发很长。"]]],[35,12,"урок","Здесь куда холоднее, чем в Пекине · часть 2","","",[["我家很近。","wǒ jiā hěn jìn.","Мой дом очень близко."],["这样做不对。","zhèyàng zuò bú duì.","Так делать неправильно."],["别那样说。","bié nàyàng shuō.","Не говори так."],["我坐地铁上班。","wǒ zuò dìtiě shàngbān.","Я езжу на работу на метро."]],[["我家很＿＿。",["那样","地铁","近"],2,"我家很近。\nМой дом очень близко."],["＿＿做不对。",["这样","比较","那样"],0,"这样做不对。\nТак делать неправильно."],["别＿＿说。",["地铁","那样","近"],1,"别那样说。\nНе говори так."],["我坐＿＿上班。",["比较","地铁","近"],1,"我坐地铁上班。\nЯ езжу на работу на метро."]],[[["我","家","很","近","。"],"Мой дом очень близко.","我家很近。"],[["这样","做","不","对","。"],"Так делать неправильно.","这样做不对。"],[["别","那样","说","。"],"Не говори так.","别那样说。"]]],[36,12,"урок","Здесь куда холоднее, чем в Пекине · часть 3","","",[["他从小喜欢画画。","tā cóngxiǎo xǐhuan huàhuà.","Он с детства любит рисовать."],["如果下雨，我就不去。","rúguǒ xiàyǔ, wǒ jiù bú qù.","Если будет дождь, я не пойду."],["这个汉字很难。","zhège Hànzì hěn nán.","Этот иероглиф очень трудный."]],[["他＿＿喜欢画画。",["汉字","如果","从小"],2,"他从小喜欢画画。\nОн с детства любит рисовать."],["＿＿下雨，我就不去。",["如果","从小","汉字"],0,"如果下雨，我就不去。\nЕсли будет дождь, я не пойду."],["这个＿＿很难。",["如果","汉字","从小"],1,"这个汉字很难。\nЭтот иероглиф очень трудный."]],[[["他","从小","喜欢","画画","。"],"Он с детства любит рисовать.","他从小喜欢画画。"],[["如果","下雨","，","我","就","不","去","。"],"Если будет дождь, я не пойду.","如果下雨，我就不去。"],[["这","个","汉字","很","难","。"],"Этот иероглиф очень трудный.","这个汉字很难。"]]],[37,13,"урок","Мы полюбили уроки китайского · часть 1","","Двойное дополнение. Формула: глагол + кому + что. После глаголов передачи идут сразу два дополнения: 他给我一本书 — «он дал мне книгу», 老师教我们中文.",[["这条路很长。","zhè tiáo lù hěn cháng.","Эта дорога очень длинная."],["前面有个商店。","qiánmiàn yǒu ge shāngdiàn.","Впереди есть магазин."],["往左走。","wǎng zuǒ zǒu.","Идите налево."]],[["这条＿＿很长。",["路","左","前面"],0,"这条路很长。\nЭта дорога очень длинная."],["＿＿有个商店。",["路","前面","左"],1,"前面有个商店。\nВпереди есть магазин."],["往＿＿走。",["前面","左","路"],1,"往左走。\nИдите налево."]],[[["这","条","路","很","长","。"],"Эта дорога очень длинная.","这条路很长。"],[["前面","有","个","商店","。"],"Впереди есть магазин.","前面有个商店。"],[["往","左","走","。"],"Идите налево.","往左走。"]]],[38,13,"урок","Мы полюбили уроки китайского · часть 2","","",[["往右走。","wǎng yòu zǒu.","Идите направо."],["新年快乐！","xīnnián kuàilè!","С Новым годом!"],["他邀请我去他家。","tā yāoqǐng wǒ qù tā jiā.","Он пригласил меня к себе домой."]],[["往＿＿走。",["邀请","新年","右"],2,"往右走。\nИдите направо."],["＿＿快乐！",["邀请","右","新年"],2,"新年快乐！\nС Новым годом!"],["他＿＿我去他家。",["邀请","右","新年"],0,"他邀请我去他家。\nОн пригласил меня к себе домой."]],[[["往","右","走","。"],"Идите направо.","往右走。"],[["新年","快乐","！"],"С Новым годом!","新年快乐！"],[["他","邀请","我","去","他","家","。"],"Он пригласил меня к себе домой.","他邀请我去他家。"]]],[39,13,"урок","Мы полюбили уроки китайского · часть 3","","",[["对方没有回答。","duìfāng méiyǒu huídá.","Собеседник не ответил."],["明天晚上有一个聚会。","míngtiān wǎnshang yǒu yí gè jùhuì.","Завтра вечером будет вечеринка."],["我买了一双鞋。","wǒ mǎi le yì shuāng xié.","Я купил пару обуви."]],[["＿＿没有回答。",["对方","双","聚会"],0,"对方没有回答。\nСобеседник не ответил."],["明天晚上有一个＿＿。",["双","对方","聚会"],2,"明天晚上有一个聚会。\nЗавтра вечером будет вечеринка."],["我买了一＿＿鞋。",["聚会","对方","双"],2,"我买了一双鞋。\nЯ купил пару обуви."]],[[["对方","没有","回答","。"],"Собеседник не ответил.","对方没有回答。"],[["明天","晚上","有","一","个","聚会","。"],"Завтра вечером будет вечеринка.","明天晚上有一个聚会。"],[["我","买","了","一","双","鞋","。"],"Я купил пару обуви.","我买了一双鞋。"]]],[40,14,"урок","Как скучно встречать Новый год одному · часть 1","","Наречие степени 多: высокая степень. Формула: 多 + прилагательное + 啊. Восклицание о том, насколько сильно выражен признак: 一个人过年多没意思啊 — «как же скучно встречать Новый год одному».",[["我们回家过年。","wǒmen huíjiā guònián.","Мы едем домой встречать Новый год."],["我小时候很胖。","wǒ xiǎoshíhou hěn pàng.","В детстве я был толстым."],["那个女孩儿很可爱。","nà ge nǚháir hěn kě'ài.","Та девочка очень милая."],["小孩儿在外面玩。","xiǎoháir zài wàimiàn wán.","Дети играют на улице."]],[["我们回家＿＿。",["过年","小时候","鸟"],0,"我们回家过年。\nМы едем домой встречать Новый год."],["我＿＿很胖。",["小时候","小孩儿","女孩儿"],0,"我小时候很胖。\nВ детстве я был толстым."],["那个＿＿很可爱。",["小时候","小孩儿","女孩儿"],2,"那个女孩儿很可爱。\nТа девочка очень милая."],["＿＿在外面玩。",["过年","小孩儿","女孩儿"],1,"小孩儿在外面玩。\nДети играют на улице."]],[[["我们","回家","过年","。"],"Мы едем домой встречать Новый год.","我们回家过年。"],[["我","小时候","很","胖","。"],"В детстве я был толстым.","我小时候很胖。"],[["那","个","女孩儿","很","可爱","。"],"Та девочка очень милая.","那个女孩儿很可爱。"]]],[41,14,"урок","Как скучно встречать Новый год одному · часть 2","","",[["我的床很大。","wǒ de chuáng hěn dà.","У меня большая кровать."],["我住三楼。","wǒ zhù sān lóu.","Я живу на третьем этаже."],["鸟在天上飞。","niǎo zài tiānshang fēi.","Птица летает в небе."],["他们买了新房子。","tāmen mǎi le xīn fángzi.","Они купили новый дом."]],[["我的＿＿很大。",["飞","床","一直"],1,"我的床很大。\nУ меня большая кровать."],["我住三＿＿。",["楼","床","房子"],0,"我住三楼。\nЯ живу на третьем этаже."],["鸟在天上＿＿。",["飞","楼","床"],0,"鸟在天上飞。\nПтица летает в небе."],["他们买了新＿＿。",["楼","房子","床"],1,"他们买了新房子。\nОни купили новый дом."]],[[["我","的","床","很","大","。"],"У меня большая кровать.","我的床很大。"],[["我","住","三","楼","。"],"Я живу на третьем этаже.","我住三楼。"],[["鸟","在","天上","飞","。"],"Птица летает в небе.","鸟在天上飞。"]]],[42,14,"урок","Как скучно встречать Новый год одному · часть 3","","",[["他的优点是很认真。","tā de yōudiǎn shì hěn rènzhēn.","Его достоинство — он очень добросовестный."],["我有一个新的计划。","wǒ yǒu yí ge xīn de jìhuà.","У меня есть новый план."],["我一定会来的。","wǒ yídìng huì lái de.","Я обязательно приду."],["这里发生了什么事？","zhèlǐ fāshēng le shénme shì?","Что здесь произошло?"]],[["他的＿＿是很认真。",["优点","一定","计划"],0,"他的优点是很认真。\nЕго достоинство — он очень добросовестный."],["我有一个新的＿＿。",["一定","计划","优点"],1,"我有一个新的计划。\nУ меня есть новый план."],["我＿＿会来的。",["一定","优点","发生"],0,"我一定会来的。\nЯ обязательно приду."],["这里＿＿了什么事？",["发生","优点","计划"],0,"这里发生了什么事？\nЧто здесь произошло?"]],[[["他","的","优点","是","很","认真","。"],"Его достоинство — он очень добросовестный.","他的优点是很认真。"],[["我","有","一","个","新","的","计划","。"],"У меня есть новый план.","我有一个新的计划。"],[["我","一定","会","来","的","。"],"Я обязательно приду.","我一定会来的。"]]],[43,15,"урок","Хочу ещё раз съездить в Китай · часть 1","","Предложение с 有 (2): достигнутое количество. Формула: кто/что + 有 + мера. Называет достигнутый размер, возраст или срок: 他有一米八 — «в нём метр восемьдесят».",[["我买了机票。","wǒ mǎi le jīpiào.","Я купил авиабилет."],["我去机场。","wǒ qù jīchǎng.","Я еду в аэропорт."],["她明年要出国。","tā míngnián yào chūguó.","В следующем году она уедет за границу."],["下周见！","xià zhōu jiàn!","Увидимся на следующей неделе!"]],[["我买了＿＿。",["出国","机场","机票"],2,"我买了机票。\nЯ купил авиабилет."],["我去＿＿。",["出国","周","机场"],2,"我去机场。\nЯ еду в аэропорт."],["她明年要＿＿。",["出国","机场","从"],0,"她明年要出国。\nВ следующем году она уедет за границу."],["下＿＿见！",["周","机场","出国"],0,"下周见！\nУвидимся на следующей неделе!"]],[[["我","买","了","机票","。"],"Я купил авиабилет.","我买了机票。"],[["我","去","机场","。"],"Я еду в аэропорт.","我去机场。"],[["她","明年","要","出国","。"],"В следующем году она уедет за границу.","她明年要出国。"]]],[44,15,"урок","Хочу ещё раз съездить в Китай · часть 2","","",[["他出门了。","tā chū mén le.","Он вышел из дома."],["请进！","qǐng jìn!","Входите, пожалуйста!"],["别动！","bié dòng!","Не двигайся!"],["我姓王。","wǒ xìng Wáng.","Моя фамилия Ван."]],[["他＿＿门了。",["进","动","出"],2,"他出门了。\nОн вышел из дома."],["请＿＿！",["动","进","姓"],1,"请进！\nВходите, пожалуйста!"],["别＿＿！",["进","中国","动"],2,"别动！\nНе двигайся!"],["我＿＿王。",["中国","出","姓"],2,"我姓王。\nМоя фамилия Ван."]],[[["他","出","门","了","。"],"Он вышел из дома.","他出门了。"],[["请","进","！"],"Входите, пожалуйста!","请进！"],[["别","动","！"],"Не двигайся!","别动！"]]],[45,15,"урок","Хочу ещё раз съездить в Китай · часть 3","","",[["你要好好休息。","nǐ yào hǎohǎo xiūxi.","Тебе нужно как следует отдохнуть."],["他好像生病了。","tā hǎoxiàng shēngbìng le.","Кажется, он заболел."],["说说你对中国的感受吧。","shuōshuo nǐ duì Zhōngguó de gǎnshòu ba.","Расскажи о своих впечатлениях о Китае."],["我学习汉语。","wǒ xuéxí Hànyǔ.","Я изучаю китайский язык."]],[["你要＿＿休息。",["好好","数量","汉语"],0,"你要好好休息。\nТебе нужно как следует отдохнуть."],["他＿＿生病了。",["好好","汉语","好像"],2,"他好像生病了。\nКажется, он заболел."],["说说你对中国的＿＿吧。",["感受","汉语","数量"],0,"说说你对中国的感受吧。\nРасскажи о своих впечатлениях о Китае."],["我学习＿＿。",["感受","好像","汉语"],2,"我学习汉语。\nЯ изучаю китайский язык."]],[[["你","要","好好","休息","。"],"Тебе нужно как следует отдохнуть.","你要好好休息。"],[["他","好像","生病","了","。"],"Кажется, он заболел.","他好像生病了。"],[["说说","你","对","中国","的","感受","吧","。"],"Расскажи о своих впечатлениях о Китае.","说说你对中国的感受吧。"]]]],"listening":[[2,"第三部分",[["男","给您笔，请在这儿写一下您的姓名。"],["女","好的，是这儿吗？"]],"问：女的要写什么？",["姓名","时间","问题"],["xìngmíng","shíjiān","wèntí"],0,"М: «Вот ручка, напишите здесь, пожалуйста, ваше имя». Ж: «Хорошо, здесь?» Вопрос: что должна написать женщина?"],[2,"第三部分",[["女","你怎么还没去机场？"],["男","飞机晚点了，下午四点才起飞。"]],"问：飞机几点起飞？",["两点","四点","十点"],["liǎng diǎn","sì diǎn","shí diǎn"],1,"Ж: «Почему ты ещё не поехал в аэропорт?» М: «Самолёт задерживается, вылет только в четыре часа дня». Вопрос: во сколько вылетает самолёт?"],[2,"第三部分",[["男","这件衣服怎么样？"],["女","颜色很好看，但是有点儿大。"]],"问：女的觉得衣服怎么样？",["太贵了","颜色不好","有点儿大"],["tài guì le","yánsè bù hǎo","yǒudiǎnr dà"],2,"М: «Как тебе эта одежда?» Ж: «Цвет красивый, но немного великовата». Вопрос: что женщина думает об одежде?"],[2,"第三部分",[["女","你每天几点到公司？"],["男","八点半。我坐公共汽车，要四十分钟。"]],"问：男的怎么去公司？",["坐公共汽车","开车","骑自行车"],["zuò gōnggòng qìchē","kāichē","qí zìxíngchē"],0,"Ж: «Во сколько ты каждый день приходишь в компанию?» М: «В половине девятого. Езжу на автобусе, дорога занимает сорок минут». Вопрос: как мужчина добирается до работы?"],[2,"第三部分",[["男","你的眼睛怎么红了？"],["女","昨天晚上看书看到两点，没睡好。"]],"问：女的为什么没睡好？",["生病了","看书看得太晚","工作太忙"],["shēngbìng le","kàn shū kàn de tài wǎn","gōngzuò tài máng"],1,"М: «Почему у тебя красные глаза?» Ж: «Вчера читала до двух ночи, не выспалась». Вопрос: почему женщина не выспалась?"],[2,"第三部分",[["女","请问，火车站怎么走？"],["男","一直往前走，到第二个路口往右走就到了。"]],"问：女的要去哪儿？",["机场","医院","火车站"],["jīchǎng","yīyuàn","huǒchēzhàn"],2,"Ж: «Скажите, пожалуйста, как пройти к вокзалу?» М: «Идите прямо, на втором перекрёстке поверните направо — и вы на месте». Вопрос: куда нужно женщине?"],[2,"第三部分",[["男","你喜欢什么运动？"],["女","我喜欢游泳，每个星期去两次。"]],"问：女的喜欢什么运动？",["游泳","跑步","踢足球"],["yóuyǒng","pǎobù","tī zúqiú"],0,"М: «Какой спорт тебе нравится?» Ж: «Я люблю плавать, хожу два раза в неделю». Вопрос: какой спорт любит женщина?"],[2,"第三部分",[["女","这个西瓜多少钱？"],["男","十五块。"],["女","太贵了，十块可以吗？"],["男","好吧，给你。"]],"问：女的最后花了多少钱？",["十五块","十块","五块"],["shíwǔ kuài","shí kuài","wǔ kuài"],1,"Ж: «Сколько стоит этот арбуз?» М: «Пятнадцать юаней». Ж: «Слишком дорого, можно за десять?» М: «Ладно, держите». Вопрос: сколько в итоге заплатила женщина?"],[2,"第三部分",[["男","你认识那个穿白衣服的人吗？"],["女","认识，她是我们的新同学，叫李月。"]],"问：李月是谁？",["老师","医生","新同学"],["lǎoshī","yīshēng","xīn tóngxué"],2,"М: «Ты знаешь человека в белой одежде?» Ж: «Знаю, это наша новая одноклассница, её зовут Ли Юэ». Вопрос: кто такая Ли Юэ?"],[2,"第三部分",[["女","明天我们去公园玩儿吧。"],["男","听说明天有雨，我们在家看电影吧。"]],"问：男的为什么不想去公园？",["明天下雨","公园太远","他很累"],["míngtiān xià yǔ","gōngyuán tài yuǎn","tā hěn lèi"],0,"Ж: «Давай завтра пойдём гулять в парк». М: «Говорят, завтра дождь, давай посмотрим фильм дома». Вопрос: почему мужчина не хочет идти в парк?"],[2,"第三部分",[["男","你姐姐是做什么工作的？"],["女","她在一家宾馆工作，以前是老师。"]],"问：姐姐现在在哪儿工作？",["学校","宾馆","医院"],["xuéxiào","bīnguǎn","yīyuàn"],1,"М: «Кем работает твоя старшая сестра?» Ж: «Она работает в гостинице, раньше была учителем». Вопрос: где сейчас работает сестра?"],[2,"第三部分",[["女","服务员，我要一杯咖啡。"],["男","对不起，咖啡没有了，您喝茶吗？"],["女","好，那给我一杯茶吧。"]],"问：女的最后要了什么？",["咖啡","牛奶","茶"],["kāfēi","niúnǎi","chá"],2,"Ж: «Официант, мне чашку кофе». М: «Извините, кофе закончился, будете чай?» Ж: «Хорошо, тогда чашку чая». Вопрос: что в итоге заказала женщина?"],[2,"第三部分",[["男","你的生日是几月几号？"],["女","九月十号，就是下个星期三。"]],"问：女的生日是哪天？",["九月十号","十月九号","九月四号"],["jiǔ yuè shí hào","shí yuè jiǔ hào","jiǔ yuè sì hào"],0,"М: «Какого числа твой день рождения?» Ж: «Десятого сентября, то есть в следующую среду». Вопрос: когда день рождения женщины?"],[2,"第三部分",[["女","你找什么呢？"],["男","我的手表，刚才还在桌子上。"],["女","是不是在你的包里？"]],"问：男的在找什么？",["手机","手表","包"],["shǒujī","shǒubiǎo","bāo"],1,"Ж: «Что ты ищешь?» М: «Свои часы, только что были на столе». Ж: «Может, они у тебя в сумке?» Вопрос: что ищет мужчина?"],[2,"第三部分",[["男","你的汉语说得真好！"],["女","谢谢，我在中国学习了两年。"]],"问：女的在中国学习了多长时间？",["一年","半年","两年"],["yì nián","bàn nián","liǎng nián"],2,"М: «Ты так хорошо говоришь по-китайски!» Ж: «Спасибо, я два года училась в Китае». Вопрос: сколько женщина училась в Китае?"],[2,"第三部分",[["女","我们几点出发？"],["男","电影七点开始，我们六点半从家里走。"]],"问：电影几点开始？",["七点","六点半","六点"],["qī diǎn","liù diǎn bàn","liù diǎn"],0,"Ж: «Во сколько выходим?» М: «Фильм начинается в семь, выйдем из дома в половине седьмого». Вопрос: во сколько начинается фильм?"],[2,"第三部分",[["男","你今天怎么不高兴？"],["女","我的考试没考好，只考了六十分。"]],"问：女的为什么不高兴？",["丢了东西","考试没考好","生病了"],["diū le dōngxi","kǎoshì méi kǎo hǎo","shēngbìng le"],1,"М: «Почему ты сегодня грустная?» Ж: «Я плохо сдала экзамен, всего шестьдесят баллов». Вопрос: почему женщина расстроена?"],[2,"第三部分",[["女","你弟弟比你高吗？"],["男","对，他比我高，也比我重。"]],"问：谁比较高？",["男的","一样高","男的弟弟"],["nán de","yíyàng gāo","nán de dìdi"],2,"Ж: «Твой младший брат выше тебя?» М: «Да, он выше меня и тяжелее». Вопрос: кто выше?"],[2,"第三部分",[["男","喂，你在哪儿呢？"],["女","我在商店门口等你呢，你快来吧。"]],"问：女的在哪儿？",["商店门口","学校门口","家里"],["shāngdiàn ménkǒu","xuéxiào ménkǒu","jiā li"],0,"М: «Алло, ты где?» Ж: «Жду тебя у входа в магазин, иди скорее». Вопрос: где женщина?"],[2,"第三部分",[["女","这个房间太小了。"],["男","那我们去看看旁边那个，那个大一点儿。"]],"问：他们觉得这个房间怎么样？",["太大了","太小了","很好"],["tài dà le","tài xiǎo le","hěn hǎo"],1,"Ж: «Эта комната слишком маленькая». М: «Тогда пойдём посмотрим соседнюю, она побольше». Вопрос: какой им кажется эта комната?"],[2,"第三部分",[["男","你已经吃药了吗？"],["女","还没有，医生说饭后吃。"]],"问：女的什么时候吃药？",["饭前","睡觉前","饭后"],["fàn qián","shuìjiào qián","fàn hòu"],2,"М: «Ты уже выпила лекарство?» Ж: «Ещё нет, врач сказал пить после еды». Вопрос: когда женщина примет лекарство?"],[2,"第三部分",[["女","你会开车吗？"],["男","会，但是我没有车，我每天骑自行车。"]],"问：男的每天怎么出去？",["骑自行车","开车","坐出租车"],["qí zìxíngchē","kāichē","zuò chūzūchē"],0,"Ж: «Ты умеешь водить машину?» М: «Умею, но машины у меня нет, я каждый день езжу на велосипеде». Вопрос: как мужчина передвигается каждый день?"],[2,"第三部分",[["男","你们班有多少学生？"],["女","三十个，男生十二个，女生十八个。"]],"问：女的班里有多少女生？",["十二个","十八个","三十个"],["shí'èr ge","shíbā ge","sānshí ge"],1,"М: «Сколько учеников в вашем классе?» Ж: «Тридцать: двенадцать мальчиков и восемнадцать девочек». Вопрос: сколько девочек в классе?"],[2,"第三部分",[["女","这些是你的书吗？"],["男","不是，是我哥哥的。他让我帮他拿到学校去。"]],"问：这些书是谁的？",["男的","女的","男的哥哥"],["nán de","nǚ de","nán de gēge"],2,"Ж: «Это твои книги?» М: «Нет, моего старшего брата. Он попросил отнести их в школу». Вопрос: чьи это книги?"],[2,"第三部分",[["男","我们晚上吃什么？"],["女","家里有鱼和鸡蛋，我给你做鱼吧。"],["男","太好了，我最喜欢吃鱼。"]],"问：男的最喜欢吃什么？",["鱼","鸡蛋","面条"],["yú","jīdàn","miàntiáo"],0,"М: «Что будем есть вечером?» Ж: «Дома есть рыба и яйца, приготовлю тебе рыбу». М: «Отлично, я больше всего люблю рыбу». Вопрос: что мужчина любит больше всего?"]]}