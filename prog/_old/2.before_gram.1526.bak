ō."],["下雨","xià yǔ","идёт дождь",2,33,"","今天下雨了。","Сегодня пошёл дождь.","今天 下雨 了 。","jīntiān xià yǔ le."],["好多","hǎoduō","много",2,33,"","这里有好多人。","Здесь очень много людей.","这里 有 好多 人 。","zhèlǐ yǒu hǎoduō rén."],["最好","zuìhǎo","лучше всего",2,33,"","你最好早点儿去。","Тебе лучше пойти пораньше.","你 最好 早 点儿 去 。","nǐ zuìhǎo zǎo diǎnr qù."],["最近","zuìjìn","недавно, в последнее время",2,33,"","你最近忙吗？","Ты в последнее время занят?","你 最近 忙 吗 ？","nǐ zuìjìn máng ma?"],["之间","zhījiān","между",2,33,"","我们之间没有问题。","Между нами нет проблем.","我们 之间 没有 问题 。","wǒmen zhījiān méiyǒu wèntí."],["比","bǐ","чем (при сравнении); сравнивать",2,34,"","我比他高。","Я выше его.","我 比 他 高 。","wǒ bǐ tā gāo."],["高","gāo","высокий",2,34,"","他很高。","Он очень высокий.","他 很 高 。","tā hěn gāo."],["长","cháng / zhǎng","длинный (cháng); расти (zhǎng)",2,34,"","她的头发很长。","У неё очень длинные волосы.","她 的 头发 很 长 。","tā de tóufa hěn cháng."],["晴","qíng","ясный, солнечный",2,34,"","雨停了，天晴了。","Дождь кончился, прояснилось.","雨 停 了 ， 天 晴 了 。","yǔ tíng le, tiān qíng le."],["阴","yīn","пасмурный",2,34,"","今天天阴了。","Сегодня пасмурно.","今天 天 阴 了 。","jīntiān tiān yīn le."],["近","jìn","близкий, близко",2,35,"","我家很近。","Мой дом очень близко.","我 家 很 近 。","wǒ jiā hěn jìn."],["这样","zhèyàng","так, такой",2,35,"","这样做不对。","Так делать неправильно.","这样 做 不 对 。","zhèyàng zuò bú duì."],["那样","nàyàng","так, такой (как тот)",2,35,"","别那样说。","Не говори так.","别 那样 说 。","bié nàyàng shuō."],["地铁","dìtiě","метро",2,35,"","我坐地铁上班。","Я езжу на работу на метро.","我 坐 地铁 上班 。","wǒ zuò dìtiě shàngbān."],["比较","bǐjiào","сравнительно; сравнивать",2,35,"","今天比较冷。","Сегодня довольно холодно.","今天 比较 冷 。","jīntiān bǐjiào lěng."],["从小","cóngxiǎo","с детства",2,36,"","他从小喜欢画画。","Он с детства любит рисовать.","他 从小 喜欢 画画 。","tā cóngxiǎo xǐhuan huàhuà."],["如果","rúguǒ","если",2,36,"","如果下雨，我就不去。","Если будет дождь, я не пойду.","如果 下雨 ， 我 就 不 去 。","rúguǒ xiàyǔ, wǒ jiù bú qù."],["汉字","Hànzì","китайский иероглиф",2,36,"","这个汉字很难。","Этот иероглиф очень трудный.","这 个 汉字 很 难 。","zhège Hànzì hěn nán."],["路","lù","дорога, путь",2,37,"","这条路很长。","Эта дорога очень длинная.","这 条 路 很 长 。","zhè tiáo lù hěn cháng."],["前面","qiánmiàn","впереди",2,37,"","前面有个商店。","Впереди есть магазин.","前面 有 个 商店 。","qiánmiàn yǒu ge shāngdiàn."],["左","zuǒ","левый",2,37,"","往左走。","Идите налево.","往 左 走 。","wǎng zuǒ zǒu."],["右","yòu","правый",2,38,"","往右走。","Идите направо.","往 右 走 。","wǎng yòu zǒu."],["新年","xīnnián","Новый год",2,38,"","新年快乐！","С Новым годом!","新年 快乐 ！","xīnnián kuàilè!"],["邀请","yāoqǐng","приглашать",2,38,"","他邀请我去他家。","Он пригласил меня к себе домой.","他 邀请 我 去 他 家 。","tā yāoqǐng wǒ qù tā jiā."],["对方","duìfāng","другая сторона, собеседник",2,39,"","对方没有回答。","Собеседник не ответил.","对方 没有 回答 。","duìfāng méiyǒu huídá."],["聚会","jùhuì","вечеринка, встреча",2,39,"","明天晚上有一个聚会。","Завтра вечером будет вечеринка.","明天 晚上 有 一 个 聚会 。","míngtiān wǎnshang yǒu yí gè jùhuì."],["双","shuāng","пара; двойной",2,39,"","我买了一双鞋。","Я купил пару обуви.","我 买 了 一 双 鞋 。","wǒ mǎi le yì shuāng xié."],["过年","guònián","встречать Новый год",2,40,"","我们回家过年。","Мы едем домой встречать Новый год.","我们 回家 过年 。","wǒmen huíjiā guònián."],["小时候","xiǎoshíhou","в детстве",2,40,"","我小时候很胖。","В детстве я был толстым.","我 小时候 很 胖 。","wǒ xiǎoshíhou hěn pàng."],["女孩儿","nǚháir","девочка",2,40,"","那个女孩儿很可爱。","Та девочка очень милая.","那 个 女孩儿 很 可爱 。","nà ge nǚháir hěn kě'ài."],["小孩儿","xiǎoháir","ребёнок",2,40,"","小孩儿在外面玩。","Дети играют на улице.","小孩儿 在 外面 玩 。","xiǎoháir zài wàimiàn wán."],["鸟","niǎo","птица",2,40,"","树上有鸟。","На дереве птица.","树 上 有 鸟 。","shù shang yǒu niǎo."],["床","chuáng","кровать",2,41,"","我的床很大。","У меня большая кровать.","我 的 床 很 大 。","wǒ de chuáng hěn dà."],["楼","lóu","здание; этаж",2,41,"","我住三楼。","Я живу на третьем этаже.","我 住 三 楼 。","wǒ zhù sān lóu."],["飞","fēi","летать",2,41,"","鸟在天上飞。","Птица летает в небе.","鸟 在 天上 飞 。","niǎo zài tiānshang fēi."],["房子","fángzi","дом",2,41,"","他们买了新房子。","Они купили новый дом.","他们 买 了 新 房子 。","tāmen mǎi le xīn fángzi."],["一直","yìzhí","всё время, прямо",2,41,"","雨一直在下。","Дождь идёт не переставая.","雨 一直 在 下 。","yǔ yìzhí zài xià."],["优点","yōudiǎn","достоинство",2,42,"","他的优点是很认真。","Его достоинство — он очень добросовестный.","他 的 优点 是 很 认真 。","tā de yōudiǎn shì hěn rènzhēn."],["计划","jìhuà","план; планировать",2,42,"","我有一个新的计划。","У меня есть новый план.","我 有 一 个 新 的 计划 。","wǒ yǒu yí ge xīn de jìhuà."],["一定","yídìng","обязательно, непременно",2,42,"","我一定会来的。","Я обязательно приду.","我 一定 会 来 的 。","wǒ yídìng huì lái de."],["发生","fāshēng","происходить",2,42,"","这里发生了什么事？","Что здесь произошло?","这里 发生 了 什么 事 ？","zhèlǐ fāshēng le shénme shì?"],["机票","jīpiào","авиабилет",2,43,"","我买了机票。","Я купил авиабилет.","我 买 了 机票 。","wǒ mǎi le jīpiào."],["机场","jīchǎng","аэропорт",2,43,"","我去机场。","Я еду в аэропорт.","我 去 机场 。","wǒ qù jīchǎng."],["出国","chūguó","уезжать за границу",2,43,"","她明年要出国。","В следующем году она уедет за границу.","她 明年 要 出国 。","tā míngnián yào chūguó."],["周","zhōu","неделя",2,43,"","下周见！","Увидимся на следующей неделе!","下 周 见 ！","xià zhōu jiàn!"],["从","cóng","от, из, с",2,43,"","我从北京来。","Я из Пекина.","我 从 北京 来 。","wǒ cóng Běijīng lái."],["出","chū","выходить",2,44,"","他出门了。","Он вышел из дома.","他 出 门 了 。","tā chū mén le."],["进","jìn","входить",2,44,"","请进！","Входите, пожалуйста!","请 进 ！","qǐng jìn!"],["动","dòng","двигаться, трогать",2,44,"","别动！","Не двигайся!","别 动 ！","bié dòng!"],["姓","xìng","фамилия; носить фамилию",2,44,"","我姓王。","Моя фамилия Ван.","我 姓 王 。","wǒ xìng Wáng."],["中国","Zhōngguó","Китай",2,44,"中 — стрела в центре мишени: «Срединное государство».","我想去中国。","Я хочу поехать в Китай.","我 想 去 中国 。","wǒ xiǎng qù Zhōngguó."],["好好","hǎohǎo","как следует",2,45,"","你要好好休息。","Тебе нужно как следует отдохнуть.","你 要 好好 休息 。","nǐ yào hǎohǎo xiūxi."],["好像","hǎoxiàng","кажется, будто",2,45,"","他好像生病了。","Кажется, он заболел.","他 好像 生病 了 。","tā hǎoxiàng shēngbìng le."],["感受","gǎnshòu","ощущение; ощущать",2,45,"","说说你对中国的感受吧。","Расскажи о своих впечатлениях о Китае.","说说 你 对 中国 的 感受 吧 。","shuōshuo nǐ duì Zhōngguó de gǎnshòu ba."],["汉语","Hànyǔ","китайский язык",2,45,"","我学习汉语。","Я изучаю китайский язык.","我 学习 汉语 。","wǒ xuéxí Hànyǔ."],["数量","shùliàng","количество",2,45,"","学生的数量越来越多。","Количество студентов растёт.","学生 的 数量 越来越 多 。","xuésheng de shùliàng yuèláiyuè duō."]],"lessons":[[1,1,"урок","Она угостила нас уткой по-пекински · часть 1","","Просьба со словами 请, 让, 叫. Формула: 请/让/叫 + кто + что делать. 请 — вежливая просьба, 让 — «позволить, пусть», 叫 — «велеть». 请你帮我一下 — «помоги мне, пожалуйста».",[["我马上就来。","wǒ mǎshàng jiù lái.","Я сейчас же приду."],["我给你书。","wǒ gěi nǐ shū.","Я даю тебе книгу."],["妈妈让我回家。","māma ràng wǒ huíjiā.","Мама велит мне идти домой."],["我去机场接你。","wǒ qù jīchǎng jiē nǐ.","Я встречу тебя в аэропорту."]],[["我马上＿＿来。",["接","就","帮忙"],1,"我马上就来。\nЯ сейчас же приду."],["我＿＿你书。",["帮忙","给","次"],1,"我给你书。\nЯ даю тебе книгу."],["妈妈＿＿我回家。",["让","游","次"],0,"妈妈让我回家。\nМама велит мне идти домой."],["我去机场＿＿你。",["接","旅游","给"],0,"我去机场接你。\nЯ встречу тебя в аэропорту."]],[[["我","马上","就","来","。"],"Я сейчас же приду.","我马上就来。"],[["我","给","你","书","。"],"Я даю тебе книгу.","我给你书。"],[["妈妈","让","我","回家","。"],"Мама велит мне идти домой.","妈妈让我回家。"]]],[2,1,"урок","Она угостила нас уткой по-пекински · часть 2","","Частица 吧 (2): предположение. Формула: предложение + 吧. Говорящий не уверен и ждёт подтверждения: 你是老师吧？ — «Вы ведь учитель?»",[["不是。","bú shì.","Нет, не так."],["经朋友介绍，我认识了她。","jīng péngyou jièshào, wǒ rènshi le tā.","Меня познакомил с ней друг."],["我来介绍一下。","wǒ lái jièshào yíxià.","Позвольте представить."],["我有时喝咖啡。","wǒ yǒushí hē kāfēi.","Я иногда пью кофе."]],[["＿＿是。",["时","不","懂"],1,"不是。\nНет, не так."],["＿＿朋友介绍，我认识了她。",["经","有时","懂"],0,"经朋友介绍，我认识了她。\nМеня познакомил с ней друг."],["我来＿＿一下。",["姓名","介绍","下来"],1,"我来介绍一下。\nПозвольте представить."],["我＿＿喝咖啡。",["下来","姓名","有时"],2,"我有时喝咖啡。\nЯ иногда пью кофе."]],[[["不","是","。"],"Нет, не так.","不是。"],[["我","来","介绍","一下","。"],"Позвольте представить.","我来介绍一下。"],[["我","有时","喝","咖啡","。"],"Я иногда пью кофе.","我有时喝咖啡。"]]],[3,1,"урок","Она угостила нас уткой по-пекински · часть 3","","Конструкция 是……的: выделение обстоятельства. Формула: 是 + время/место/способ + глагол + 的. Подчёркивает, когда, где или как произошло уже случившееся действие: 我是今天早上到的 — «Я приехал сегодня утром». В утвердительном и вопросительном предложении 是 можно опустить, в отрицательном — нельзя.",[["我晚上上网。","wǒ wǎnshang shàngwǎng.","Вечером я сижу в интернете."],["门票多少钱？","ménpiào duōshao qián?","Сколько стоит входной билет?"],["这位是王老师。","zhè wèi shì Wáng lǎoshī.","Это учитель Ван."],["我们晚上烤肉吧。","wǒmen wǎnshang kǎo ròu ba.","Давай вечером пожарим мясо."]],[["我晚上＿＿。",["交","肯定","上网"],2,"我晚上上网。\nВечером я сижу в интернете."],["＿＿多少钱？",["烤","估计","门票"],2,"门票多少钱？\nСколько стоит входной билет?"],["这＿＿是王老师。",["烤","门票","位"],2,"这位是王老师。\nЭто учитель Ван."],["我们晚上＿＿肉吧。",["做饭","烤","上网"],1,"我们晚上烤肉吧。\nДавай вечером пожарим мясо."]],[[["我","晚上","上网","。"],"Вечером я сижу в интернете.","我晚上上网。"],[["门票","多少","钱","？"],"Сколько стоит входной билет?","门票多少钱？"],[["这","位","是","王","老师","。"],"Это учитель Ван.","这位是王老师。"]]],[4,2,"урок","Давай лучше поедем в Бэйда на такси · часть 1","","Конструкция 还是……吧: выбор варианта. Формула: 还是 + вариант + 吧. Предлагает остановиться на одном варианте после раздумий: 还是打车去吧 — «давай лучше на такси».",[["我坐公交车上班。","wǒ zuò gōngjiāochē shàngbān.","Я езжу на работу на автобусе."],["他很累，但很高兴。","tā hěn lèi, dàn hěn gāoxìng.","Он очень устал, но очень рад."],["我在车站等你。","wǒ zài chēzhàn děng nǐ.","Я жду тебя на остановке."],["学校很远。","xuéxiào hěn yuǎn.","Школа очень далеко."]],[["我坐＿＿上班。",["站","公交车","但"],1,"我坐公交车上班。\nЯ езжу на работу на автобусе."],["他很累，＿＿很高兴。",["但","打车","名"],0,"他很累，但很高兴。\nОн очень устал, но очень рад."],["我在＿＿等你。",["车","车站","名"],1,"我在车站等你。\nЯ жду тебя на остановке."],["学校很＿＿。",["远","车站","站"],0,"学校很远。\nШкола очень далеко."]],[[["我","坐","公交车","上班","。"],"Я езжу на работу на автобусе.","我坐公交车上班。"],[["他","很","累","，","但","很","高兴","。"],"Он очень устал, но очень рад.","他很累，但很高兴。"],[["我","在","车站","等","你","。"],"Я жду тебя на остановке.","我在车站等你。"]]],[5,2,"урок","Давай лучше поедем в Бэйда на такси · часть 2","","",[["我在网上买书。","wǒ zài wǎngshang mǎi shū.","Я покупаю книги в интернете."],["他是外国人。","tā shì wàiguó rén.","Он иностранец."],["这是一间教室。","zhè shì yì jiān jiàoshì.","Это учебный класс."],["教室里没有人。","jiàoshì lǐ méiyǒu rén.","В классе никого нет."]],[["我在＿＿买书。",["室","网上","外国"],1,"我在网上买书。\nЯ покупаю книги в интернете."],["他是＿＿人。",["外国","教室","上"],0,"他是外国人。\nОн иностранец."],["这是一＿＿教室。",["间","票","别"],0,"这是一间教室。\nЭто учебный класс."],["＿＿里没有人。",["过来","教室","国"],1,"教室里没有人。\nВ классе никого нет."]],[[["我","在","网上","买","书","。"],"Я покупаю книги в интернете.","我在网上买书。"],[["他","是","外国","人","。"],"Он иностранец.","他是外国人。"],[["这","是","一","间","教室","。"],"Это учебный класс.","这是一间教室。"]]],[6,2,"урок","Давай лучше поедем в Бэйда на такси · часть 3","","",[["这家饭馆的服务很好。","zhè jiā fànguǎn de fúwù hěn hǎo.","В этом ресторане очень хорошее обслуживание."],["我们的校园很美。","wǒmen de xiàoyuán hěn měi.","Наш кампус очень красивый."],["这篇文章写得很好。","zhè piān wénzhāng xiě de hěn hǎo.","Эта статья очень хорошо написана."],["这次考试很容易。","zhè cì kǎoshì hěn róngyì.","Этот экзамен очень лёгкий."]],[["这家饭馆的＿＿很好。",["服务","数字","银行"],0,"这家饭馆的服务很好。\nВ этом ресторане очень хорошее обслуживание."],["我们的＿＿很美。",["数字","校园","容易"],1,"我们的校园很美。\nНаш кампус очень красивый."],["这篇＿＿写得很好。",["附近","文章","实际上"],1,"这篇文章写得很好。\nЭта статья очень хорошо написана."],["这次考试很＿＿。",["容易","校园","实际上"],0,"这次考试很容易。\nЭтот экзамен очень лёгкий."]],[[["这","家","饭馆","的","服务","很","好","。"],"В этом ресторане очень хорошее обслуживание.","这家饭馆的服务很好。"],[["我们","的","校园","很","美","。"],"Наш кампус очень красивый.","我们的校园很美。"],[["这","篇","文章","写","得","很","好","。"],"Эта статья очень хорошо написана.","这篇文章写得很好。"]]],[7,3,"урок","Я хочу съездить в Сиань · часть 1","","Результативное дополнение. Формула: глагол + 完/好/到/见/懂 и т. п.. Показывает, чем закончилось действие: 看见 — «увидел», 听懂 — «понял на слух», 做完 — «сделал до конца».",[["他什么时候回来？","tā shénme shíhou huílái?","Когда он вернётся?"],["今天这么冷！","jīntiān zhème lěng!","Сегодня так холодно!"],["我吃完了。","wǒ chī wán le.","Я доел."],["我们一起走吧。","wǒmen yìqǐ zǒu ba.","Пойдём вместе."]],[["他什么时候＿＿？",["去","起","回来"],2,"他什么时候回来？\nКогда он вернётся?"],["今天＿＿冷！",["洗","起","这么"],2,"今天这么冷！\nСегодня так холодно!"],["我吃＿＿了。",["回来","手","完"],2,"我吃完了。\nЯ доел."],["我们＿＿走吧。",["一起","出去","这么"],0,"我们一起走吧。\nПойдём вместе."]],[[["他","什么","时候","回来","？"],"Когда он вернётся?","他什么时候回来？"],[["今天","这么","冷","！"],"Сегодня так холодно!","今天这么冷！"],[["我","吃","完","了","。"],"Я доел.","我吃完了。"]]],[8,3,"урок","Я хочу съездить в Сиань · часть 2","","Удвоение глагола. Формула: глагол + глагол  /  глагол + 一 + глагол  /  глагол + 了 + глагол. Действие короткое, лёгкое или пробное: 看看 — «взглянуть», 试一试 — «попробовать», 休息休息 — «немного отдохнуть».",[["这家饭馆不错。","zhè jiā fànguǎn búcuò.","Этот ресторан неплохой."],["这个字错了。","zhè ge zì cuò le.","Этот иероглиф неправильный."],["你为什么不来？","nǐ wèi shénme bù lái?","Почему ты не пришёл?"],["我送你一本书。","wǒ sòng nǐ yì běn shū.","Я дарю тебе книгу."]],[["这家饭馆＿＿。",["不错","送","提出"],0,"这家饭馆不错。\nЭтот ресторан неплохой."],["这个字＿＿了。",["不错","错","累"],1,"这个字错了。\nЭтот иероглиф неправильный."],["你＿＿不来？",["不错","累","为什么"],2,"你为什么不来？\nПочему ты не пришёл?"],["我＿＿你一本书。",["送","累","每"],0,"我送你一本书。\nЯ дарю тебе книгу."]],[[["这","家","饭馆","不错","。"],"Этот ресторан неплохой.","这家饭馆不错。"],[["这","个","字","错","了","。"],"Этот иероглиф неправильный.","这个字错了。"],[["你","为什么","不","来","？"],"Почему ты не пришёл?","你为什么不来？"]]],[9,3,"урок","Я хочу съездить в Сиань · часть 3","","",[["没车了，我们只能走路。","méi chē le, wǒmen zhǐ néng zǒulù.","Автобусов нет, нам остаётся только идти пешком."],["这本书很有用。","zhè běn shū hěn yǒuyòng.","Эта книга очень полезная."],["考生请进考场。","kǎoshēng qǐng jìn kǎochǎng.","Экзаменуемые, пройдите в аудиторию."],["请记一下我的电话。","qǐng jì yíxià wǒ de diànhuà.","Запишите, пожалуйста, мой телефон."]],[["没车了，我们＿＿走路。",["绿茶","记","只能"],2,"没车了，我们只能走路。\nАвтобусов нет, нам остаётся только идти пешком."],["这本书很＿＿。",["客厅","考生","有用"],2,"这本书很有用。\nЭта книга очень полезная."],["＿＿请进考场。",["聊天儿","有用","考生"],2,"考生请进考场。\nЭкзаменуемые, пройдите в аудиторию."],["请＿＿一下我的电话。",["记","经历","绿茶"],0,"请记一下我的电话。\nЗапишите, пожалуйста, мой телефон."]],[[["没","车","了","，","我们","只能","走路","。"],"Автобусов нет, нам остаётся только идти пешком.","没车了，我们只能走路。"],[["这","本","书","很","有用","。"],"Эта книга очень полезная.","这本书很有用。"],[["考生","请","进","考场","。"],"Экзаменуемые, пройдите в аудиторию.","考生请进考场。"]]],[10,4,"урок","Тебе очень идёт красное · часть 1","","Причина и следствие: 因为……，所以……. Формула: 因为 + причина，所以 + следствие. Можно оставить одну часть: 因为下雨，所以我没去 — «так как шёл дождь, я не пошёл».",[["我去过中国。","wǒ qù guo Zhōngguó.","Я бывал в Китае."],["我们去商场吧。","wǒmen qù shāngchǎng ba.","Пойдём в торговый центр."],["我们进去吧。","wǒmen jìnqù ba.","Давайте войдём."],["我买了一条鱼。","wǒ mǎi le yì tiáo yú.","Я купил рыбу."]],[["我去＿＿中国。",["过","子","商场"],0,"我去过中国。\nЯ бывал в Китае."],["我们去＿＿吧。",["商场","裤子","子"],0,"我们去商场吧。\nПойдём в торговый центр."],["我们＿＿吧。",["试","商场","进去"],2,"我们进去吧。\nДавайте войдём."],["我买了一＿＿鱼。",["进去","商场","条"],2,"我买了一条鱼。\nЯ купил рыбу."]],[[["我","去","过","中国","。"],"Я бывал в Китае.","我去过中国。"],[["我们","去","商场","吧","。"],"Пойдём в торговый центр.","我们去商场吧。"],[["我们","进去","吧","。"],"Давайте войдём.","我们进去吧。"]]],[11,4,"урок","Тебе очень идёт красное · часть 2","","",[["她穿红色的衣服。","tā chuān hóngsè de yīfu.","Она в красной одежде."],["下雨了，所以我不去。","xiàyǔ le, suǒyǐ wǒ bú qù.","Пошёл дождь, поэтому я не пойду."],["我为你高兴。","wǒ wèi nǐ gāoxìng.","Я рад за тебя."],["他以第一名的成绩毕业。","tā yǐ dì-yī míng de chéngjì bìyè.","Он окончил учёбу лучшим на курсе."]],[["她穿＿＿的衣服。",["红色","绿色","更"],0,"她穿红色的衣服。\nОна в красной одежде."],["下雨了，＿＿我不去。",["以","所以","过去"],1,"下雨了，所以我不去。\nПошёл дождь, поэтому я не пойду."],["我＿＿你高兴。",["更","过去","为"],2,"我为你高兴。\nЯ рад за тебя."],["他＿＿第一名的成绩毕业。",["以","包","黑色"],0,"他以第一名的成绩毕业。\nОн окончил учёбу лучшим на курсе."]],[[["她","穿","红色","的","衣服","。"],"Она в красной одежде.","她穿红色的衣服。"],[["下雨","了","，","所以","我","不","去","。"],"Пошёл дождь, поэтому я не пойду.","下雨了，所以我不去。"],[["我","为","你","高兴","。"],"Я рад за тебя.","我为你高兴。"]]],[12,4,"урок","Тебе очень идёт красное · часть 3","","",[["你喜欢什么颜色？","nǐ xǐhuan shénme yánsè?","Какой цвет тебе нравится?"],["顾客是我们的朋友。","gùkè shì wǒmen de péngyou.","Клиенты — наши друзья."],["入口在大楼的东边。","rùkǒu zài dàlóu de dōngbian.","Вход находится с восточной стороны здания."],["我们的关系很好。","wǒmen de guānxì hěn hǎo.","У нас очень хорошие отношения."]],[["你喜欢什么＿＿？",["友好","颜色","不便"],1,"你喜欢什么颜色？\nКакой цвет тебе нравится?"],["＿＿是我们的朋友。",["友好","关系","顾客"],2,"顾客是我们的朋友。\nКлиенты — наши друзья."],["＿＿在大楼的东边。",["友好","入口","关系"],1,"入口在大楼的东边。\nВход находится с восточной стороны здания."],["我们的＿＿很好。",["入口","关系","不便"],1,"我们的关系很好。\nУ нас очень хорошие отношения."]],[[["你","喜欢","什么","颜色","？"],"Какой цвет тебе нравится?","你喜欢什么颜色？"],[["顾客","是","我们","的","朋友","。"],"Клиенты — наши друзья.","顾客是我们的朋友。"],[["入口","在","大楼","的","东边","。"],"Вход находится с восточной стороны здания.","入口在大楼的东边。"]]],[13,5,"урок","Первый раз в гостях у китайских друзей · часть 1","","Конструкция 都……了: «уже». Формула: 都 + количество/время + 了. Подчёркивает, что срок большой или дело давно сделано: 都十点了 — «уже десять часов».",[["他走得很快。","tā zǒu de hěn kuài.","Он ходит очень быстро."],["你上来吧。","nǐ shànglái ba.","Поднимайся сюда."],["猫在床下面。","māo zài chuáng xiàmiàn.","Кошка под кроватью."],["我想吃面。","wǒ xiǎng chī miàn.","Я хочу поесть лапши."]],[["他走得很＿＿。",["奶奶","快","礼物"],1,"他走得很快。\nОн ходит очень быстро."],["你＿＿吧。",["礼物","面","上来"],2,"你上来吧。\nПоднимайся сюда."],["猫在床＿＿。",["礼物","进来","下面"],2,"猫在床下面。\nКошка под кроватью."],["我想吃＿＿。",["奶奶","面","快"],1,"我想吃面。\nЯ хочу поесть лапши."]],[[["他","走","得","很","快","。"],"Он ходит очень быстро.","他走得很快。"],[["你","上来","吧","。"],"Поднимайся сюда.","你上来吧。"],[["猫","在","床","下面","。"],"Кошка под кроватью.","猫在床下面。"]]],[14,5,"урок","Первый раз в гостях у китайских друзей · часть 2","","",[["我在准备考试。","wǒ zài zhǔnbèi kǎoshì.","Я готовлюсь к экзамену."],["考试前他备好了所有文具。","kǎoshì qián tā bèi hǎo le suǒyǒu wénjù.","Перед экзаменом он подготовил все канцтовары."],["我想喝奶茶。","wǒ xiǎng hē nǎichá.","Я хочу выпить молочного чаю."],["我跟朋友去。","wǒ gēn péngyou qù.","Я иду с другом."]],[["我在＿＿考试。",["准备","走","跟"],0,"我在准备考试。\nЯ готовлюсь к экзамену."],["考试前他＿＿好了所有文具。",["走","备","起来"],1,"考试前他备好了所有文具。\nПеред экзаменом он подготовил все канцтовары."],["我想喝＿＿。",["简单","奶茶","准备"],1,"我想喝奶茶。\nЯ хочу выпить молочного чаю."],["我＿＿朋友去。",["店","备","跟"],2,"我跟朋友去。\nЯ иду с другом."]],[[["我","在","准备","考试","。"],"Я готовлюсь к экзамену.","我在准备考试。"],[["我","想","喝","奶茶","。"],"Я хочу выпить молочного чаю.","我想喝奶茶。"],[["我","跟","朋友","去","。"],"Я иду с другом.","我跟朋友去。"]]],[15,5,"урок","Первый раз в гостях у китайских друзей · часть 3","","",[["今天家里来了客人。","jīntiān jiāli lái le kèrén.","Сегодня к нам домой пришли гости."],["欢迎来我家做客。","huānyíng lái wǒ jiā zuòkè.","Приходи ко мне в гости."],["把书放在桌子上。","bǎ shū fàng zài zhuōzi shang.","Положи книгу на стол."],["他对工作很不满。","tā duì gōngzuò hěn bùmǎn.","Он очень недоволен работой."]],[["今天家里来了＿＿。",["出来","带","客人"],2,"今天家里来了客人。\nСегодня к нам домой пришли гости."],["欢迎来我家＿＿。",["做客","客人","庆祝"],0,"欢迎来我家做客。\nПриходи ко мне в гости."],["把书＿＿在桌子上。",["出来","放","不满"],1,"把书放在桌子上。\nПоложи книгу на стол."],["他对工作很＿＿。",["方向","带","不满"],2,"他对工作很不满。\nОн очень недоволен работой."]],[[["今天","家里","来","了","客人","。"],"Сегодня к нам домой пришли гости.","今天家里来了客人。"],[["欢迎","来","我","家","做客","。"],"Приходи ко мне в гости.","欢迎来我家做客。"],[["把","书","放","在","桌子","上","。"],"Положи книгу на стол.","把书放在桌子上。"]]],[16,6,"урок","Сяосюэ, с днём рождения! · часть 1","","Оборот ……什么的: «и тому подобное». Формула: перечисление + 什么的. Показывает, что список не окончен: 面包、鸡蛋什么的 — «хлеб, яйца и всё такое».",[["今天是我的生日。","jīntiān shì wǒ de shēngrì.","Сегодня мой день рождения."],["生日快乐！","shēngrì kuàilè!","С днём рождения!"],["这朵花很美。","zhè duǒ huā hěn měi.","Этот цветок очень красивый."],["他在画画儿。","tā zài huà huàr.","Он рисует картину."]],[["今天是我的＿＿。",["快乐","生日",