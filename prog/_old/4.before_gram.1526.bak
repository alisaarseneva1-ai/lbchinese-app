качества."]],[[["妈妈","给","我","买","了","毛衣","。"],"Мама купила мне свитер.","妈妈给我买了毛衣。"],[["他","的","样子","很","累","。"],"У него очень усталый вид.","他的样子很累。"],[["这","件","衣服","很","适合","你","。"],"Эта одежда тебе очень подходит.","这件衣服很适合你。"]]],[46,12,"урок","Счастливая семья · часть 2","","Двойное отрицание. Формула: 不/没 + … + 不 …. Два отрицания дают сильное утверждение: 没有人不喜欢她；不能不说.",[["我估计他今天不来了。","wǒ gūjì tā jīntiān bù lái le.","Думаю, он сегодня не придёт."],["这本杂志每月出一期。","zhè běn zázhì měi yuè chū yì qī.","Этот журнал выходит раз в месяц."],["我的听力不太好。","wǒ de tīnglì bú tài hǎo.","Я не очень хорошо понимаю на слух."],["别说了，我很烦。","bié shuō le, wǒ hěn fán.","Хватит, я очень раздражён."]],[["我＿＿他今天不来了。",["烦","估计","心"],1,"我估计他今天不来了。\nДумаю, он сегодня не придёт."],["这本杂志每月出一＿＿。",["期","力","脾气"],0,"这本杂志每月出一期。\nЭтот журнал выходит раз в месяц."],["我的＿＿不太好。",["脾气","听力","期"],1,"我的听力不太好。\nЯ не очень хорошо понимаю на слух."],["别说了，我很＿＿。",["烦","脾气","批评"],0,"别说了，我很烦。\nХватит, я очень раздражён."]],[[["我","估计","他","今天","不","来","了","。"],"Думаю, он сегодня не придёт.","我估计他今天不来了。"],[["我","的","听力","不","太","好","。"],"Я не очень хорошо понимаю на слух.","我的听力不太好。"],[["别","说","了","，","我","很","烦","。"],"Хватит, я очень раздражён.","别说了，我很烦。"]]],[47,12,"урок","Счастливая семья · часть 3","","无论……都…… — «что бы ни». Формула: 无论 + вопросительное слово，都 + результат. Книжный вариант 不管: 无论遇到什么困难，他都不放弃.",[["我老家在山东。","wǒ lǎojiā zài Shāndōng.","Я родом из Шаньдуна."],["他自小就喜欢音乐。","tā zì xiǎo jiù xǐhuan yīnyuè.","Он с детства любит музыку."],["我的父母住在北京。","wǒ de fùmǔ zhù zài Běijīng.","Мои родители живут в Пекине."],["他们父子长得很像。","tāmen fùzǐ zhǎng de hěn xiàng.","Отец и сын очень похожи."]],[["我＿＿在山东。",["老家","件","无论"],0,"我老家在山东。\nЯ родом из Шаньдуна."],["他＿＿小就喜欢音乐。",["外","母亲","自"],2,"他自小就喜欢音乐。\nОн с детства любит музыку."],["我的＿＿住在北京。",["父母","自","外"],0,"我的父母住在北京。\nМои родители живут в Пекине."],["他们＿＿长得很像。",["父子","卫生","亲"],0,"他们父子长得很像。\nОтец и сын очень похожи."]],[[["我","老家","在","山东","。"],"Я родом из 